#!/bin/bash

project_folder="$(git rev-parse --show-toplevel)"
if git -C "$project_folder" rev-parse --verify HEAD >/dev/null 2>&1
then
	against=HEAD
else
	# Initial commit: diff against an empty tree object
	against="$(git -C "$project_folder" hash-object -t tree /dev/null)"
fi

# Redirect output to stderr.
exec 1>&2

tmpdir="$(mktemp -d "${TMPDIR:-/tmp}/repo-XXXXXXXX")"
trap 'rm -rf "$tmpdir"' EXIT INT

exclude_dirs=(
  conan_recipes
  src/mage/cpp/community_detection_module/grappolo
  src/mage/cpp/text_module/utf8
)

exclude_files=(
  src/mage/cpp/util_module/algorithm/md5.hpp
  src/mage/cpp/util_module/algorithm/md5.cpp
)

for cfg in .clang-format .clang-tidy; do
  if [[ -f "$project_folder/$cfg" ]]; then
    cp "$project_folder/$cfg" "$tmpdir/"
  fi
done

FAIL=0
while IFS= read -r -d '' file; do
  if [[ ! "$file" =~ \.(cpp|cc|cxx|c|h|hpp)$ ]]; then
    continue
  fi

  run_check=true
  for exclude_dir in "${exclude_dirs[@]}"; do
    if [[ "$file" == "$exclude_dir"/* || "$file" == "$exclude_dir" ]]; then
      run_check=false
      echo "Skipping $file because it is in $exclude_dir"
      break
    fi
  done
  for exclude_file in "${exclude_files[@]}"; do
    if [[ "$file" == "$exclude_file" ]]; then
      run_check=false
      echo "Skipping $file because it is in $exclude_file"
      break
    fi
  done
  if ! $run_check; then
    continue
  fi

  echo "Checking $file..."

  git -C "$project_folder" checkout-index --prefix="$tmpdir/" -- "$file"

  # Do not break header checker
  echo "Running header checker..."
  "$project_folder/tools/header-checker.py" "$tmpdir/$file" "$project_folder/$file" --amend-year
  CODE=$?
  if [ $CODE -ne 0 ]; then
    FAIL=1
  fi
done < <(git -C "$project_folder" diff --cached --name-only -z --diff-filter=AM "$against")

exit ${FAIL}
